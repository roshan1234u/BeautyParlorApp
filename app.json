{
  "expo": {
    "name": "Iswari Beautician",
    "slug": "iswari-beautician",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iswari-logo.png",
    "scheme": "iswaribeautician",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/images/iswari-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.roshandube123.iswaribeautician"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/iswari-logo.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "eb199bac-ddcc-4d06-a2bd-487ad479a38e"
      }
    }
  }
}
