{
  "expo": {
    "name": "Iswari Beautician",
    "slug": "iswari-beautician",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/iswari-logo.png",
    "scheme": "iswaribeautician",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/images/iswari-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/iswari-logo.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
